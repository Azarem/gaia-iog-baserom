{
    "name": "@gaialabs/iog-baserom",
    "version": "0.2.4",
    "type": "module",
    "description": "GaiaLabs IOG Base ROM",
    "funding": "https://github.com/sponsors/Azarem",
    "main": "dist/index.cjs",
    "types": "dist/index.d.cts",
    "module": "dist/index.mjs",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "baserom",
        "README.md"
    ],
    "scripts": {
        "prebuild": "node -p \"'export const BASEROM_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
        "build": "tsdown",
        "dev": "tsdown --watch",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist",
        "clean-install": "rm -rf node_modules && rm -rf package-lock.json && npm install",
        "publish": "tsdown && npm publish --access public",
        "extract": "rm -rf extracted/* && node --env-file=.env.local src/index.ts extract",
        "extract:lt": "rm -rf extracted/* && node --env-file=.env.local src/index.ts extract --linetracking",
        "extract-jp": "rm -rf extracted-jp && node --env-file=.env.local src/index.ts extract-jp",
        "rebuild": "node src/index.ts rebuild --artifacts",
        "rebuild-jp": "node src/index.ts rebuild-jp"
    },
    "dependencies": {
        "@gaialabs/core": "1.0.5"
    },
    "devDependencies": {
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.cts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "keywords": [
        "rom-hacking",
        "typescript",
        "web-workers",
        "nodejs",
        "browser",
        "universal"
    ],
    "author": "GaiaLabs Team",
    "license": "MIT"
}
