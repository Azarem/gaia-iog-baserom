{
    "Bitmap": {
        "extension": "bin",
        "type": "Bitmap",
        "compressed": true
    },    
    "BitmapRaw": {
        "extension": "raw.bin",
        "type": "Bitmap"
    },
    "Tilemap": {
        "extension": "map",
        "header": 2,
        "type": "Tilemap",
        "compressed": true
    },
    "Tileset": {
        "extension": "set",
        "type": "Tileset",
        "compressed": true
    },
    "Spritemap": {
        "extension": "spm",
        "type": "Spritemap",
        "compressed": true,
        "struct": "&sprite_set",
        "base": 16384
    },
    "Music": {
        "extension": "bgm",
        "type": "Music"
    },
    "Sound": {
        "extension": "sfx",
        "header": -2,
        "type": "Sound"
    },
    "Unknown": {
        "extension": "unk",
        "type": "Binary"
    },
    "Patch": {
        "extension": "patch.asm",
        "type": "Patch",
        "isPatch": true
    },
    "Assembly": {
        "extension": "asm",
        "type": "Assembly",
        "isBlock": true
    },
    "Palette": {
        "extension": "pal",
        "type": "Palette"
    },
    "Meta17": {
        "extension": "dmp",
        "header": 4,
        "type": "Meta17",
        "compressed": true
    }
